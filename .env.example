# Copy this file to .env in this same folder and fill in the two values.
#
#     cp .env.example .env
#
# .env is listed in .gitignore and must never be committed. Placeholders only
# in this file.

# ---------------------------------------------------------------------------
# Required: the model
# ---------------------------------------------------------------------------
# Portkey API key, used to reach gpt-6-luna through the OpenAI-compatible API.
# Without it the backend still starts and the shop still works - the catalogue,
# search, filters and accounts are all database-driven - but the chat assistant
# returns 503 and /api/health reports "agent_configured": false.
PORTKEY_API_KEY=your-portkey-api-key-here

# ---------------------------------------------------------------------------
# Recommended: session signing
# ---------------------------------------------------------------------------
# Signs the session tokens handed out at login. Optional: if it is unset, a new
# random key is generated each time the server boots, which works fine but logs
# everyone out on every restart.
#
# Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
CAMPUS_CUSTOMS_SECRET=generate-a-long-random-string

# ---------------------------------------------------------------------------
# Optional: override the model
# ---------------------------------------------------------------------------
# Defaults to gpt-6-luna when unset.
# OPENAI_MODEL=gpt-6-luna
